import("../../gn/skia.gni")
import("../../gn/toolchain/wasm.gni")

declare_args() {
  # The emscripten `ENVIRONMENT` value baked into the generated JS glue.
  #
  # The glue is environment specific: as soon as `node` is part of the list it reaches
  # for `module`, `fs`, `path` and `url`, which bundlers targeting the browser cannot
  # resolve. Every supported environment therefore gets its own build directory and its
  # own entry point in the npm package, see modules/simplifypath/compile.sh.
  simplifypath_environment = "web,webview,worker,node"
}

skia_wasm_lib("simplifypath") {
  deps = [
    "../..:skia",
    "../..:pathops",
  ]

  sources = [
    "WasmCommon.h",
    "path_simplify_bindings.cpp",
  ]

  ldflags = []
  if (is_debug) {
    ldflags += [
      "-O0",
      "-sASSERTIONS=1",
      "-g3",
    ]
  } else {
    ldflags += [ "-Oz" ]
  }
  ldflags += [
    "-fno-rtti",
    "--bind",
  ]

  ldflags += [
    "-sENVIRONMENT=$simplifypath_environment",
    "-sEXPORT_NAME=SimplifySvgPathInit",
    "-sALLOW_MEMORY_GROWTH",
    "-sINITIAL_MEMORY=32MB",
    "-sMODULARIZE",
    "-sEXPORT_ES6=1",
    "-sDISABLE_EXCEPTION_CATCHING",
    "-sNODEJS_CATCH_EXIT=0",
    "-sWASM",
    "-sFORCE_FILESYSTEM=0",
    "-sDYNAMIC_EXECUTION=0",
    "-sFILESYSTEM=0",
    "--pre-js",
    rebase_path("pathops.js"),
  ]

  defines = [
    "CK_INCLUDE_PATHOPS",
    "EMSCRIPTEN_HAS_UNBOUND_TYPE_NAMES=0",
  ]
}
